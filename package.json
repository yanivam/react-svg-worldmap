{
  "private": true,
  "workspaces": [
    "lib",
    "website"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "build:package": "yarn workspace react-svg-worldmap build",
    "build:website": "yarn workspace website build",
    "build": "yarn build:package && yarn build:website",
    "generate:readme": "yarn workspace react-svg-worldmap generate:readme",
    "start:website": "yarn workspace website start",
    "lint": "eslint --cache \"**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write .",
    "format-check": "prettier --list-different .",
    "typecheck": "yarn workspace website typecheck",
    "spellcheck": "cspell \"**\" --no-progress",
    "test": "yarn workspace react-svg-worldmap test",
    "test:coverage": "yarn workspace react-svg-worldmap test:coverage",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cspell": "^6.31.3",
    "eslint": "^8.57.1",
    "eslint-config-jc": "^2.3.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "^3.9.9",
    "prettier-config-jc": "^2.3.0",
    "tsconfig-jc": "^2.3.1",
    "typescript": "^4.9.5"
  },
  "version": "2.0.0",
  "resolutions": {
    "cheerio": "1.0.0",
    "webpack": ">=5.105.4 <5.106.0"
  }
}
